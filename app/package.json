{
  "name": "ddns-cf-proxyip",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/231128ikun/DDNS-cf-proxyip.git"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:worker",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run test/unit/api-contract.test.ts",
    "test:unit": "vitest run --exclude test/unit/api-contract.test.ts",
    "check": "npm run typecheck && npm run test:contract && npm run test:unit && npm run build && npm run check:size && npm run smoke",
    "deploy": "npm run check && wrangler deploy",
    "check:size": "node scripts/check-size.mjs",
    "smoke": "node scripts/smoke.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "audit:flows": "node scripts/ui-startup.mjs && node scripts/ui-flows.mjs --flows --current-only",
    "audit:ui:regression": "node --test scripts/ui-audit-diff.test.mjs && node scripts/ui-audit.mjs --compare-baseline --out .wrangler/tmp/ui-regression"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "terser": "^5.51.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
